# Obtén tu clave en https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx

# Quién recibe los mensajes del formulario (por defecto: ventas@dgmcloud.dev)
CONTACT_TO_EMAIL=ventas@dgmcloud.dev

# Remitente verificado en Resend (tras verificar dominio dgmcloud.dev usa algo como):
# CONTACT_FROM_EMAIL=DGM Cloud <ventas@dgmcloud.dev>
# En pruebas sin dominio verificado Resend permite solo onboarding@resend.dev:
CONTACT_FROM_EMAIL=DGM Cloud <onboarding@resend.dev>
